{
  "name": "spiro-craft",
  "version": "1.0.0",
  "private": true,
  "description": "A geometric playground for curious minds",
  "main": "desktop.cjs",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "desktop:pack": "npm run build && electron-packager . 'Spiro Craft' --platform=darwin --out=release --overwrite --ignore='^/(release|tests|public|components|lib|.local|.git)($|/)'"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.1",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
